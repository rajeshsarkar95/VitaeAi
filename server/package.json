{
  "name": "polish-server",
  "version": "0.1.0",
  "private": true,
  "description": "Optional standalone Express API — most teams should prefer the Next.js API routes in src/app/api instead, unless you need a long-running process (queues, websockets) outside the Next.js runtime.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "4.21.1",
    "cors": "2.8.5",
    "helmet": "8.0.0",
    "morgan": "1.10.0",
    "mongoose": "8.8.1",
    "jsonwebtoken": "9.0.2",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "@types/express": "5.0.0",
    "@types/cors": "2.8.17",
    "@types/morgan": "1.9.9",
    "@types/node": "22.9.0"
  }
}
